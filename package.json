{
  "name": "clown-counter-bot",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.3",
  "scripts": {
    "dev": "node --import=tsx --env-file-if-exists=.env --watch src/index.ts",
    "start": "node --import=tsx --env-file-if-exists=.env src/index.ts",
    "lint": "eslint . --fix",
    "db:studio": "drizzle-kit studio",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "db:generate": "drizzle-kit generate",
    "prepare": "simple-git-hooks && git config --local commit.template '.gitmessage'"
  },
  "dependencies": {
    "@grammyjs/auto-retry": "2.0.2",
    "@grammyjs/commands": "1.3.2",
    "@grammyjs/i18n": "1.1.2",
    "@libsql/client": "0.17.4",
    "@t3-oss/env-core": "0.13.11",
    "drizzle-orm": "0.45.2",
    "grammy": "1.45.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@commitlint/types": "21.2.0",
    "@fullstacksjs/eslint-config": "14.8.0",
    "@rabits/tsconfig": "0.2.2",
    "@types/node": "26.1.1",
    "drizzle-kit": "0.31.10",
    "eslint": "10.7.0",
    "lint-staged": "17.2.0",
    "prettier": "3.9.6",
    "simple-git-hooks": "2.13.1",
    "tsx": "4.23.1",
    "typescript": "6.0.3"
  }
}
