{
  "name": "clown-counter-bot",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite-node -w src/index.ts",
    "build": "vp pack",
    "start": "node dist/index.js",
    "lint": "vp lint --fix",
    "check": "vp check",
    "archive": "rm -f dist.zip && zip -r dist.zip dist .env.example",
    "db:studio": "drizzle-kit studio",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "db:generate": "drizzle-kit generate",
    "prepare": "vp hooks enable"
  },
  "dependencies": {
    "@grammyjs/auto-retry": "2.0.2",
    "@grammyjs/commands": "1.4.0",
    "@grammyjs/i18n": "1.1.2",
    "@grammyjs/runner": "2.0.3",
    "@libsql/client": "0.17.4",
    "drizzle-orm": "0.45.2",
    "grammy": "1.45.1"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@commitlint/types": "21.2.0",
    "@rabits/tsconfig": "0.2.2",
    "@types/node": "26.2.0",
    "drizzle-kit": "0.31.10",
    "typescript": "6.0.3",
    "vite-node": "6.0.0",
    "vite-plus": "0.3.0"
  },
  "packageManager": "pnpm@11.21.0"
}
