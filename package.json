{
  "name": "clown-counter-bot",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite-node -w src/index.ts",
    "build": "vp pack",
    "start": "node dist/index.mjs",
    "lint": "vp lint --fix",
    "check": "vp check",
    "test": "vp test --run",
    "archive": "rm -f dist.zip && zip -r dist.zip dist .env.example",
    "db:studio": "drizzle-kit studio",
    "db:migrate": "drizzle-kit migrate",
    "db:generate": "drizzle-kit generate",
    "prepare": "vp hooks enable"
  },
  "dependencies": {
    "@grammyjs/auto-retry": "catalog:bot",
    "@grammyjs/commands": "catalog:bot",
    "@grammyjs/i18n": "catalog:bot",
    "@grammyjs/runner": "catalog:bot",
    "drizzle-orm": "catalog:db",
    "grammy": "catalog:bot",
    "pg": "catalog:db"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:lint",
    "@commitlint/config-conventional": "catalog:lint",
    "@commitlint/types": "catalog:lint",
    "@electric-sql/pglite": "catalog:db",
    "@fullstacksjs/oxlint-config": "catalog:lint",
    "@types/node": "catalog:tooling",
    "@types/pg": "catalog:db",
    "drizzle-kit": "catalog:db",
    "typescript": "catalog:tooling",
    "vite-node": "catalog:tooling",
    "vite-plus": "catalog:tooling"
  },
  "packageManager": "pnpm@11.24.0"
}
